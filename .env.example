# FutureHub Production Environment Variables Template

# Node.js Server Environment
NODE_ENV=production
PORT=5000

# Security & Authentication
JWT_SECRET=

# Database Configuration (Optional: defaults to server/futurehub.db)
# On Render with Persistent Disk, set to: /var/data/futurehub.db
DATABASE_PATH=

# CORS Configuration (Optional: only needed if frontend is hosted on a separate domain)
# Example: https://futurehub-client.onrender.com
FRONTEND_URL=
