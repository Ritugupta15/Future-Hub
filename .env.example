# FutureHub Environment Configuration Template
# Copy this file to .env for local overrides

# Flask Application Settings
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=0
SECRET_KEY=replace-with-a-secure-random-key-in-production

# Server Configuration
HOST=127.0.0.1
PORT=5000

# Database Configuration (defaults to instance/futurehub.db)
DATABASE_PATH=instance/futurehub.db
